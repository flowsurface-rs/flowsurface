language(1)
indicator("Bollinger Bands", id = "core.bollinger-bands", sourceable = true, max_bars_back = 1)
display(view = "plot", attachment = "overlay", layer_name = "Bollinger Basis")
format(precision = "base_ticker_min_tick")
period = input.int(20, "Period", min = 2, max = 200)
method = input.string("Sma", "Average method", options = ["Sma", "Ema", "Vwma"])
std_dev_multiplier = input.float(2.0, "Std. deviation", min = 0.0, max = 5.0, step = 0.1)
source = input.source(chart.close, "Source")
basis = switch method {
    "Sma" => ta.sma(source, period),
    "Ema" => ta.ema(source, period),
    default => ta.vwma(source, chart.volume, period)
}
deviation = ta.stdev(source, period) * std_dev_multiplier
plot(basis, id = "value", title = "Basis", precision = "instrument", color_slot = "main", layer_title = "BB", width = 1.1, pane = "main")
plot(basis + deviation, id = "bollinger.upper", title = "Upper", precision = "instrument", color_slot = "upper", layer_title = "U", pane = "main")
plot(basis - deviation, id = "bollinger.lower", title = "Lower", precision = "instrument", color_slot = "lower", layer_title = "L", pane = "main")

style("main", title = "Basis")
style("upper", title = "Upper band", role = "success")
style("lower", title = "Lower band", role = "danger")
style("fill", title = "Background fill", role = "primary", shade = "faint")
fill(upper = "bollinger.upper", lower = "bollinger.lower", geometry = "series_band", color_slot = "fill", opacity = 0.12)
