language(1)
indicator("Stochastic Oscillator", id = "catalog.stochastic", sourceable = true, max_bars_back = 1)
display(panel_title = "Stochastic", layer_name = "Stochastic")
format(precision = "fixed_step:0.01", axis_labels = "compact", header_labels = "compact", max_decimals = 2)
period = input.int(14, "%K period", min = 1, max = 200)
k_period = input.int(3, "K smoothing", min = 1, max = 100)
d_period = input.int(3, "D smoothing", min = 1, max = 100)
upper_band = input.float(80.0, "Overbought", min = 1.0, max = 99.0, step = 1.0)
lower_band = input.float(20.0, "Oversold", min = 1.0, max = 99.0, step = 1.0)
lowest = ta.lowest(chart.low, period)
highest = ta.highest(chart.high, period)
range = highest - lowest
raw = select(range <= 0, 50, 100 * (chart.close - lowest) / range)
k = ta.sma(raw, k_period)
d = ta.sma(k, d_period)
plot(k, id = "k", title = "%K", precision = "decimals:2", color_slot = "k", width = 1.2)
plot(d, id = "d", title = "%D", precision = "decimals:2", color_slot = "d")
plot(upper_band, id = "upper", title = "Overbought", precision = "decimals:2", color_slot = "upper", layer_title = "OB", width = 0.9)
plot(lower_band, id = "lower", title = "Oversold", precision = "decimals:2", color_slot = "lower", layer_title = "OS", width = 0.9)

style("k", title = "%K", role = "primary")
style("d", title = "%D", role = "warning")
style("upper", title = "Overbought", role = "success")
style("lower", title = "Oversold", role = "danger")
mark(title = "Line", source = "k", kind = "line", color_slot = "k")
