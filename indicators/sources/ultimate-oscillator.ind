language(1)
indicator("Ultimate Oscillator", id = "catalog.ultimate-oscillator", sourceable = true, max_bars_back = 2)
format(precision = "fixed_step:0.01", axis_labels = "compact", header_labels = "compact", max_decimals = 2)
previous_close = chart.close[1]
true_low = math.min(chart.low, previous_close)
true_high = math.max(chart.high, previous_close)
buying_pressure = chart.close - true_low
true_range = true_high - true_low
fast = ta.sma(buying_pressure, 7) / ta.sma(true_range, 7)
medium = ta.sma(buying_pressure, 14) / ta.sma(true_range, 14)
slow = ta.sma(buying_pressure, 28) / ta.sma(true_range, 28)
value = 100 * (4 * fast + 2 * medium + slow) / 7
plot(value, id = "value", title = "Ultimate Oscillator", precision = "decimals:2", color_slot = "main", layer_title = "Ultimate", width = 1.2)

style("main", title = "Ultimate", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
