language(1)
indicator("CVD", id = "core.cumulative-volume-delta", sourceable = true, max_bars_back = 1)
display(layer_name = "Cumulative Volume Delta")
format(precision = "base_ticker_min_qty", axis_labels = "abbreviated", header_labels = "commas")
show_change_bars = input.bool(false, "Show change bars", group = "display")
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, na)
value = ta.cum(delta)
change = select(show_change_bars, delta, na)
plot(value, id = "value", title = "CVD", precision = "instrument", color_slot = "main", layer_title = "Cumulative Volume Delta", overlay = false)
plot(change, id = "change", title = "CVD change", precision = "instrument", scale = "independent", style = "histogram", mark = "regular_bar", color_slot = "change", overlay = false)

style("main", title = "Line")
style("change", title = "Change bars", role = "secondary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
mark(title = "Bars", source = "value", kind = "regular_bar", color_slot = "main")
mark(title = "Change bars", source = "change", kind = "regular_bar", color_slot = "change")
