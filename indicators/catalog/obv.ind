language(1)
indicator("On-Balance Volume", id = "flowsurface.obv", layer_name = "OBV", value_precision = "base_ticker_min_qty", axis_label_mode = "abbreviated", header_label_mode = "commas")
state total = 0
total := total + select(chart.close > chart.close[1], chart.volume, select(chart.close < chart.close[1], -chart.volume, 0))
plot(total, id = "value", title = "OBV", precision = "instrument", color_slot = "main", width = 1.2)

style("main", title = "OBV", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
