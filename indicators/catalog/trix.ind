language(1)
indicator("TRIX", id = "flowsurface.trix", value_precision = "fixed_step:0.0001", axis_label_mode = "compact", header_label_mode = "compact", max_decimals = 4)
period = input.int(15, "Period", min = 1, max = 200)
first = ta.ema(chart.close, period)
second = ta.ema(first, period)
third = ta.ema(second, period)
value = 100 * (third / third[1] - 1)
plot(value, id = "value", title = "TRIX", precision = "decimals:4", color_slot = "main", width = 1.2)

style("main", title = "TRIX", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
