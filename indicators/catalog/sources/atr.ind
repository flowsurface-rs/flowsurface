language(1)
indicator("ATR", id = "catalog.atr", max_bars_back = 1)
display(layer_name = "Average True Range")
format(precision = "base_ticker_min_tick", axis_labels = "compact", header_labels = "compact", scale = "fit_visible")
period = input.int(14, "Period", min = 1, max = 200)
true_range = ta.tr(chart.high, chart.low, chart.close)
average = ta.rma(true_range, period)
plot(average, id = "value", title = "ATR", precision = "instrument", color_slot = "main", layer_title = "Average True Range", width = 1.2)

style("main", title = "ATR")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
mark(title = "Bars", source = "value", kind = "regular_bar", color_slot = "main")
