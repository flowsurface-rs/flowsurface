language(1)
indicator("Bollinger Bands", id = "catalog.bollinger-bands", view = "primary_overlay", max_bars_back = 1, layer_name = "Bollinger Basis")
period = input.int(20, "Period", min = 2, max = 200)
method = input.string("Sma", "Average method", options = ["Sma", "Ema", "Vwma"])
std_dev_multiplier = input.float(2.0, "Std. deviation", min = 0.0, max = 5.0, step = 0.1)
basis_sma = ta.sma(chart.close, period)
basis_ema = ta.ema(chart.close, period)
basis_vwma = ta.vwma(chart.close, chart.volume, period)
basis = select(method == "Sma", basis_sma, select(method == "Ema", basis_ema, basis_vwma))
deviation = ta.stdev(chart.close, period) * std_dev_multiplier
plot(basis, id = "value", title = "Basis", precision = "instrument", color_slot = "main", layer_title = "BB", width = 1.1)
plot(basis + deviation, id = "bollinger.upper", title = "Upper", precision = "instrument", color_slot = "upper", layer_title = "U")
plot(basis - deviation, id = "bollinger.lower", title = "Lower", precision = "instrument", color_slot = "lower", layer_title = "L")

style("main", title = "Basis")
style("upper", title = "Upper band", role = "success")
style("lower", title = "Lower band", role = "danger")
style("fill", title = "Background fill", role = "primary", shade = "faint")
fill(upper = "bollinger.upper", lower = "bollinger.lower", geometry = "series_band", color_slot = "fill", opacity = 0.12)
