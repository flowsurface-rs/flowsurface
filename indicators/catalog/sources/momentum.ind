language(1)
indicator("Momentum", id = "catalog.momentum", max_bars_back = 500)
display(attachment = "panel")
format(precision = "base_ticker_min_tick", axis_labels = "compact", header_labels = "compact")
period = input.int(10, "Period", min = 1, max = 500)
source = input.source(chart.close, "Source")
value = source - source[period]
plot(value, id = "value", title = "Momentum", precision = "instrument", color_slot = "main", width = 1.2)

style("main", title = "Momentum", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
