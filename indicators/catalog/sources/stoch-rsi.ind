language(1)
indicator("Stoch RSI", id = "catalog.stoch-rsi", sourceable = true, max_bars_back = 2)
display(attachment = "panel")
format(precision = "fixed_step:0.01", axis_labels = "compact", header_labels = "compact", max_decimals = 2)
rsi_length = input.int(14, "RSI length", min = 2, max = 200)
stoch_length = input.int(14, "Stoch length", min = 1, max = 200)
k_smoothing = input.int(3, "K", min = 1, max = 100)
d_smoothing = input.int(3, "D", min = 1, max = 100)
source = input.source(chart.close, "Source")
upper_band = input.float(80.0, "Upper band", min = 1.0, max = 99.0, step = 1.0)
lower_band = input.float(20.0, "Lower band", min = 1.0, max = 99.0, step = 1.0)
rsi = ta.rsi(source, rsi_length)
lowest = ta.lowest(rsi, stoch_length)
highest = ta.highest(rsi, stoch_length)
range = highest - lowest
raw = select(range <= 0.000001, 50, (rsi - lowest) / range * 100)
k = ta.sma(raw, k_smoothing)
d = ta.sma(k, d_smoothing)
plot(k, id = "value", title = "K", precision = "decimals:2", color_slot = "main", width = 1.2)
plot(d, id = "stoch_rsi.d", title = "D", precision = "decimals:2", color_slot = "signal")
plot(upper_band, id = "upper_band", title = "Overbought", precision = "decimals:2", color_slot = "upper", layer_title = "OB", width = 0.9)
plot(lower_band, id = "lower_band", title = "Oversold", precision = "decimals:2", color_slot = "lower", layer_title = "OS", width = 0.9)

style("main", title = "K")
style("signal", title = "D", role = "warning")
style("fill", title = "Background fill", role = "primary", shade = "faint")
style("upper", title = "Overbought", role = "success")
style("lower", title = "Oversold", role = "danger")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
mark(title = "Bars", source = "value", kind = "regular_bar", color_slot = "main")
fill(upper = "upper_band", lower = "lower_band", color_slot = "fill", opacity = 0.12)
