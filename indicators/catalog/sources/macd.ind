language(1)
indicator("MACD", id = "catalog.macd", max_bars_back = 1)
display(attachment = "panel")
format(precision = "base_ticker_min_tick", axis_labels = "compact", header_labels = "compact", scale = "fit_visible_include_zero")
fast_period = input.int(12, "Fast period", min = 1, max = 200)
slow_period = input.int(26, "Slow period", min = 2, max = 500)
signal_period = input.int(9, "Signal period", min = 1, max = 200)
source = input.source(chart.close, "Source")
fast = ta.ema(source, fast_period)
slow = ta.ema(source, slow_period)
line = fast - slow
signal = ta.ema(line, signal_period)
histogram = line - signal
plot(histogram, id = "histogram", title = "Histogram", precision = "instrument", style = "histogram", color_slot = "histogram", style_by = "histogram_color", true_color_slot = "positive", false_color_slot = "negative", overlay = false)
plot(line, id = "line", title = "MACD", precision = "instrument", color_slot = "line", width = 1.2)
plot(signal, id = "signal", title = "Signal", precision = "instrument", color_slot = "signal")
plot(histogram >= 0, id = "histogram_color", title = "Histogram direction", overlay = false, layer = false)

style("line", title = "MACD", role = "primary")
style("signal", title = "Signal", role = "warning")
style("histogram", title = "Histogram")
style("positive", title = "Positive histogram", role = "success")
style("negative", title = "Negative histogram", role = "danger")
mark(title = "Histogram", source = "histogram", kind = "histogram", color_slot = "histogram", true_color_slot = "positive", false_color_slot = "negative")
