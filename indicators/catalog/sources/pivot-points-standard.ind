language(1)
indicator("Pivot Points Standard", id = "catalog.pivot-points-standard", view = "primary_overlay", max_bars_back = 1, layer_name = "Pivot Points")
timeframe = input.string("auto", "Pivot timeframe", options = ["auto", "D", "W", "M"])
selected_high = ta.highest(chart.high, 24)
selected_low = ta.lowest(chart.low, 24)
selected_close = chart.close
range = selected_high - selected_low
pivot = (selected_high + selected_low + selected_close) / 3
plot(pivot, id = "pp", title = "Pivot", precision = "instrument", color_slot = "pivot", mark = "horizontal_level")
plot(2 * pivot - selected_low, id = "r1", title = "R1", precision = "instrument", color_slot = "resistance", mark = "horizontal_level")
plot(2 * pivot - selected_high, id = "s1", title = "S1", precision = "instrument", color_slot = "support", mark = "horizontal_level")
plot(pivot + range, id = "r2", title = "R2", precision = "instrument", color_slot = "resistance", mark = "horizontal_level")
plot(pivot - range, id = "s2", title = "S2", precision = "instrument", color_slot = "support", mark = "horizontal_level")

style("pivot", title = "Pivot", role = "primary")
style("support", title = "Support", role = "success")
style("resistance", title = "Resistance", role = "danger")
