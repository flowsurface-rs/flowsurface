language(1)
indicator("Supertrend", id = "catalog.supertrend", view = "primary_overlay", max_bars_back = 1)
period = input.int(10, "ATR period", min = 1, max = 200)
multiplier = input.float(3.0, "Multiplier", min = 0.1, max = 20.0, step = 0.1)
atr = coalesce(ta.rma(ta.tr(chart.high, chart.low, chart.close), period), ta.tr(chart.high, chart.low, chart.close))
mid = (chart.high + chart.low) / 2
basic_upper = mid + multiplier * atr
basic_lower = mid - multiplier * atr
state trend = true
state upper = basic_upper
state lower = basic_lower
state line = basic_lower
state previous_close = chart.close
next_upper = select(basic_upper < upper || previous_close > upper, basic_upper, upper)
next_lower = select(basic_lower > lower || previous_close < lower, basic_lower, lower)
next_trend = select(trend, select(chart.close < next_lower, false, true), select(chart.close > next_upper, true, false))
next_line = select(next_trend == trend, select(next_trend, next_lower, next_upper), na)
trend := next_trend
upper := next_upper
lower := next_lower
line := next_line
previous_close := chart.close
plot(line, id = "line", title = "Supertrend", precision = "instrument", color_slot = "bull", style_by = "trend", true_color_slot = "bull", false_color_slot = "bear", width = 1.2)
plot(upper, id = "upper", title = "Upper band", precision = "instrument", color_slot = "bear", overlay = false, layer = false)
plot(lower, id = "lower", title = "Lower band", precision = "instrument", color_slot = "bull", overlay = false, layer = false)
plot(trend, id = "trend", title = "Bull trend", overlay = false, layer = false)

style("bull", title = "Bull", role = "success")
style("bear", title = "Bear", role = "danger")
mark(title = "Line", source = "line", kind = "line", color_slot = "bull", true_color_slot = "bull", false_color_slot = "bear")
