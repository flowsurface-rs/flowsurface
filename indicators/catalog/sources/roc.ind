language(1)
indicator("Rate of Change", id = "catalog.roc", max_bars_back = 500, layer_name = "ROC", value_precision = "fixed_step:0.01", axis_label_mode = "compact", header_label_mode = "compact", max_decimals = 2)
period = input.int(12, "Period", min = 1, max = 500)
past = chart.close[period]
value = 100 * (chart.close / past - 1)
plot(value, id = "value", title = "ROC", precision = "decimals:2", color_slot = "main", width = 1.2)

style("main", title = "ROC", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
