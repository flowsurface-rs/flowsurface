language(1)
indicator("Aroon", id = "catalog.aroon", sourceable = true, max_bars_back = 1)
format(precision = "fixed_step:0.01", axis_labels = "compact", header_labels = "compact", max_decimals = 2)
period = input.int(25, "Period", min = 1, max = 500)
high_bars = ta.highestbars(chart.high, period)
low_bars = ta.lowestbars(chart.low, period)
up = 100 * (period - high_bars) / period
down = 100 * (period - low_bars) / period
plot(up, id = "up", title = "Aroon up", precision = "decimals:2", color_slot = "up", layer_title = "Up", width = 1.1)
plot(down, id = "down", title = "Aroon down", precision = "decimals:2", color_slot = "down", layer_title = "Down", width = 1.1)

style("up", title = "Aroon up", role = "success")
style("down", title = "Aroon down", role = "danger")
mark(title = "Line", source = "up", kind = "line", color_slot = "up")
