language(1)
indicator(
    "Volume Pivot Zones", id = "catalog.volume-pivot-zones",
    sourceable = false,
    author = "akenshaw",
    author_url = "https://github.com/akenshaw",
    description = "Finds bars with the highest volume within the selected length on both sides.
\nBullish structure holds above a confirmed low; bearish structure holds below a confirmed high. These pivots form support or resistance zones until wick- or close-based mitigation.",
    max_bars_back = 101
)
display(view = "primary_overlay")

style("bullish", title = "Bullish", role = "success", shade = "base")
style("bearish", title = "Bearish", role = "danger", shade = "base")

length = input.int(5, "Volume pivot length", min = 1, max = 100)
mitigation = input.string("Wick", "Mitigation", options = ["Wick", "Close"])
show_active_only = input.bool(
    true,
    "Show active zones only",
    group = "display",
    tooltip = "Hide zones after they become inactive"
)
max_active_zones = input.int(
    256,
    "Maximum active zones",
    min = 16,
    max = 1024,
    step = 1,
    tooltip = "Retain the newest zones while they are active"
)

plot(na, id = "anchor", title = "Volume pivot zones", display = "none", pane = "main", layer = true)

volume_pivot = ta.pivothigh(chart.volume, length, length)
structure_upper = ta.highest(chart.high, length)
structure_lower = ta.lowest(chart.low, length)
state direction = 0
next_direction = select(
    chart.high[length] > structure_upper,
    -1,
    select(chart.low[length] < structure_lower, 1, direction)
)
direction := next_direction

new_bullish_zone = !na(volume_pivot) && direction == 1
new_bearish_zone = !na(volume_pivot) && direction == -1

state next_key = 0
state zones = array.new()
next_zones = array.new()

bull_wick_target = ta.lowest(chart.low, length)
bull_close_target = ta.lowest(chart.close, length)
bull_target = select(mitigation == "Wick", bull_wick_target, bull_close_target)

bear_wick_target = ta.highest(chart.high, length)
bear_close_target = ta.highest(chart.close, length)
bear_target = select(mitigation == "Wick", bear_wick_target, bear_close_target)

if new_bullish_zone {
    next_key := next_key + 1
    bull_upper = chart.hl2[length]
    bull_lower = chart.low[length]
    bull_active = na(bull_target) || bull_target >= bull_lower
    if bull_active {
        region(
            key = next_key,
            upper = bull_upper,
            lower = bull_lower,
            left_index = bar_index - length,
            right_index = bar_index,
            border_color_slot = "bullish",
            fill_color_slot = "bullish",
            extend_right = true,
            persistent = true,
            id = "volume_pivot_zones",
            width = 1.0
        )
        next_zones := array.push(next_zones, {
            key: next_key,
            upper: bull_upper,
            lower: bull_lower,
            left: bar_index - length,
            bullish: true
        })
    }
}

if new_bearish_zone {
    next_key := next_key + 1
    bear_upper = chart.high[length]
    bear_lower = chart.hl2[length]
    bear_active = na(bear_target) || bear_target <= bear_upper
    if bear_active {
        region(
            key = next_key,
            upper = bear_upper,
            lower = bear_lower,
            left_index = bar_index - length,
            right_index = bar_index,
            border_color_slot = "bearish",
            fill_color_slot = "bearish",
            extend_right = true,
            persistent = true,
            id = "volume_pivot_zones",
            width = 1.0
        )
        next_zones := array.push(next_zones, {
            key: next_key,
            upper: bear_upper,
            lower: bear_lower,
            left: bar_index - length,
            bullish: false
        })
    }
}

for zone in zones {
    zone_key = zone.key
    zone_upper = zone.upper
    zone_lower = zone.lower
    zone_left = zone.left
    zone_bullish = zone.bullish
    zone_mitigated = select(
        zone_bullish,
        !na(bull_target) && bull_target < zone_lower,
        !na(bear_target) && bear_target > zone_upper
    )
    if zone_mitigated {
        if show_active_only {
            region_remove(id = "volume_pivot_zones", key = zone_key)
        } else {
            region(
                key = zone_key,
                upper = zone_upper,
                lower = zone_lower,
                left_index = zone_left,
                right_index = bar_index,
                style_by = zone_bullish,
                true_color_slot = "bullish",
                false_color_slot = "bearish",
                extend_right = false,
                persistent = true,
                id = "volume_pivot_zones",
                width = 1.0
            )
        }
    } else if array.size(next_zones) < max_active_zones {
        next_zones := array.push(next_zones, {
            key: zone_key,
            upper: zone_upper,
            lower: zone_lower,
            left: zone_left,
            bullish: zone_bullish
        })
    } else {
        region_remove(id = "volume_pivot_zones", key = zone_key)
    }
}
zones := next_zones
