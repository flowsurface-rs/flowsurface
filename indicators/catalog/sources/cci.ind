language(1)
indicator("Commodity Channel Index", id = "catalog.cci", max_bars_back = 1, layer_name = "CCI", value_precision = "fixed_step:0.01", axis_label_mode = "compact", header_label_mode = "compact", max_decimals = 2)
period = input.int(20, "Period", min = 1, max = 200)
upper_band = input.float(100.0, "Upper band", min = 1.0, max = 500.0, step = 1.0)
lower_band = input.float(-100.0, "Lower band", min = -500.0, max = -1.0, step = 1.0)
typical = (chart.high + chart.low + chart.close) / 3
average = ta.sma(typical, period)
deviation = ta.dev(typical, period)
value = (typical - average) / (0.015 * deviation)
plot(value, id = "value", title = "CCI", precision = "decimals:2", color_slot = "main", width = 1.2)
plot(upper_band, id = "upper", title = "Upper band", precision = "decimals:2", color_slot = "upper", layer_title = "Upper", width = 0.9)
plot(lower_band, id = "lower", title = "Lower band", precision = "decimals:2", color_slot = "lower", layer_title = "Lower", width = 0.9)

style("main", title = "CCI", role = "primary")
style("upper", title = "Upper", role = "success")
style("lower", title = "Lower", role = "danger")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
