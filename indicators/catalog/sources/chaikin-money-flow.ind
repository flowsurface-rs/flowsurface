language(1)
indicator("Chaikin Money Flow", id = "catalog.chaikin-money-flow", layer_name = "CMF", value_precision = "fixed_step:0.001", axis_label_mode = "compact", header_label_mode = "compact", max_decimals = 3)
period = input.int(20, "Period", min = 1, max = 200)
range = chart.high - chart.low
multiplier = select(range <= 0, 0, ((chart.close - chart.low) - (chart.high - chart.close)) / range)
money_flow = multiplier * chart.volume
value = ta.sma(money_flow, period) / ta.sma(chart.volume, period)
plot(value, id = "value", title = "CMF", precision = "decimals:3", color_slot = "main", width = 1.2)

style("main", title = "CMF", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
