language(1)
indicator("Chaikin Oscillator", id = "catalog.chaikin-oscillator", max_bars_back = 1)
format(precision = "base_ticker_min_qty", axis_labels = "abbreviated", header_labels = "commas")
fast_period = input.int(3, "Fast period", min = 1, max = 100)
slow_period = input.int(10, "Slow period", min = 2, max = 200)
range = chart.high - chart.low
flow = select(range <= 0, 0, ((chart.close - chart.low) - (chart.high - chart.close)) / range)
accumulation = ta.cum(flow * chart.volume)
fast = ta.ema(accumulation, fast_period)
slow = ta.ema(accumulation, slow_period)
plot(fast - slow, id = "value", title = "Chaikin Oscillator", precision = "instrument", color_slot = "main", layer_title = "Chaikin", width = 1.2)

style("main", title = "Chaikin", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
