language(1)
indicator("Ichimoku Cloud", id = "catalog.ichimoku-cloud", max_bars_back = 1)
display(view = "primary_overlay")
conversion_period = input.int(9, "Conversion period", min = 1, max = 200)
base_period = input.int(26, "Base period", min = 1, max = 200)
span_period = input.int(52, "Span period", min = 1, max = 400)
conversion_high = ta.highest(chart.high, conversion_period)
conversion_low = ta.lowest(chart.low, conversion_period)
base_high = ta.highest(chart.high, base_period)
base_low = ta.lowest(chart.low, base_period)
span_high = ta.highest(chart.high, span_period)
span_low = ta.lowest(chart.low, span_period)
conversion = (conversion_high + conversion_low) / 2
base = (base_high + base_low) / 2
leading_a = (conversion + base) / 2
leading_b = (span_high + span_low) / 2
plot(conversion, id = "conversion", title = "Tenkan-sen", precision = "instrument", color_slot = "conversion")
plot(base, id = "base", title = "Kijun-sen", precision = "instrument", color_slot = "base")
plot(leading_a, id = "leading_a", title = "Leading A", precision = "instrument", color_slot = "bull_cloud", style_by = "cloud_bull", true_color_slot = "bull_cloud", false_color_slot = "bear_cloud", offset = 26, layer_title = "Senkou span A")
plot(leading_b, id = "leading_b", title = "Leading B", precision = "instrument", color_slot = "bear_cloud", style_by = "cloud_bull", true_color_slot = "bull_cloud", false_color_slot = "bear_cloud", offset = 26, layer_title = "Senkou span B")
plot(chart.close, id = "lagging", title = "Lagging", precision = "instrument", color_slot = "base", offset = -26, layer_title = "Chikou span")
plot(leading_a >= leading_b, id = "cloud_bull", title = "Cloud bullish", overlay = false, layer = false)

style("conversion", title = "Conversion", role = "primary")
style("base", title = "Base")
style("bull_cloud", title = "Bull cloud", role = "success")
style("bear_cloud", title = "Bear cloud", role = "danger")
fill(upper = "leading_a", lower = "leading_b", geometry = "series_band", color_slot = "bull_cloud", true_color_slot = "bull_cloud", false_color_slot = "bear_cloud", upper_offset = 26, lower_offset = 26, style_by = "cloud_bull")
