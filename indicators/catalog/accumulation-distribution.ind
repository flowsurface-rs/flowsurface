language(1)
indicator("Accumulation / Distribution", id = "flowsurface.accumulation-distribution", layer_name = "A/D", value_precision = "base_ticker_min_qty", axis_label_mode = "abbreviated", header_label_mode = "commas")
range = chart.high - chart.low
flow = select(range <= 0, 0, ((chart.close - chart.low) - (chart.high - chart.close)) / range)
state total = 0
total := total + flow * chart.volume
plot(total, id = "value", title = "A/D", precision = "instrument", color_slot = "main", width = 1.2)

style("main", title = "A/D", role = "primary")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
