language(1)
indicator("RSI Divergence", id = "flowsurface.rsi-divergence", max_bars_back = 500, layer_name = "RSI", value_precision = "fixed_step:1", axis_label_mode = "abbreviated", header_label_mode = "commas", max_decimals = 2)

period = input.int(14, "RSI period", min = 2, max = 200)
pivot_left = input.int(5, "Pivot lookback left", min = 1, max = 50, group = "pivots")
pivot_right = input.int(5, "Pivot lookback right", min = 1, max = 50, group = "pivots")
range_lower = input.int(5, "Minimum pivot range", min = 1, max = 200, group = "pivots")
range_upper = input.int(60, "Maximum pivot range", min = 1, max = 500, group = "pivots")
show_regular_bullish = input.bool(true, "Regular bullish", group = "signals")
show_hidden_bullish = input.bool(false, "Hidden bullish", group = "signals")
show_regular_bearish = input.bool(true, "Regular bearish", group = "signals")
show_hidden_bearish = input.bool(false, "Hidden bearish", group = "signals")

delta = chart.close - chart.close[1]
gain = select(delta >= 0, delta, 0)
loss = select(delta < 0, math.abs(delta), 0)
average_gain = ta.rma(gain, period)
average_loss = ta.rma(loss, period)
relative_strength = average_gain / average_loss
rsi = select(
    average_gain <= 0.000001,
    select(average_loss <= 0.000001, 50, 0),
    select(average_loss <= 0.000001, 100, 100 - 100 / (1 + relative_strength))
)

pivot_window = pivot_left + pivot_right + 1
pivot_low = coalesce(rsi[pivot_right] == ta.lowest(rsi, pivot_window), false)
pivot_high = coalesce(rsi[pivot_right] == ta.highest(rsi, pivot_window), false)
pivot_bar = bar_index - pivot_right
pivot_low_rsi = rsi[pivot_right]
pivot_high_rsi = rsi[pivot_right]
pivot_low_price = chart.low[pivot_right]
pivot_high_price = chart.high[pivot_right]

state has_previous_low = false
state previous_low_rsi = 0.0
state previous_low_price = 0.0
state previous_low_bar = -1
state has_previous_high = false
state previous_high_rsi = 0.0
state previous_high_price = 0.0
state previous_high_bar = -1

low_range = pivot_bar - previous_low_bar
high_range = pivot_bar - previous_high_bar
low_in_range = has_previous_low && low_range >= range_lower && low_range <= range_upper
high_in_range = has_previous_high && high_range >= range_lower && high_range <= range_upper

regular_bullish = pivot_low && low_in_range && pivot_low_price < previous_low_price && pivot_low_rsi > previous_low_rsi
hidden_bullish = pivot_low && low_in_range && pivot_low_price > previous_low_price && pivot_low_rsi < previous_low_rsi
regular_bearish = pivot_high && high_in_range && pivot_high_price > previous_high_price && pivot_high_rsi < previous_high_rsi
hidden_bearish = pivot_high && high_in_range && pivot_high_price < previous_high_price && pivot_high_rsi > previous_high_rsi

bullish_divergence = show_regular_bullish && regular_bullish || show_hidden_bullish && hidden_bullish
bearish_divergence = show_regular_bearish && regular_bearish || show_hidden_bearish && hidden_bearish

plot(rsi, id = "rsi", title = "RSI", precision = "decimals:2", color_slot = "rsi", width = 1.2)
plot(50, id = "middle_band", title = "Middle line", precision = "decimals:0", color_slot = "middle", layer_title = "Mid", width = 0.8)
plot(70, id = "upper_band", title = "Overbought", precision = "decimals:0", color_slot = "upper", layer_title = "OB", width = 0.9)
plot(30, id = "lower_band", title = "Oversold", precision = "decimals:0", color_slot = "lower", layer_title = "OS", width = 0.9)
plot(bullish_divergence, id = "bullish_divergence", title = "Bullish signal", display = "none", overlay = false, layer = false)
plot(bearish_divergence, id = "bearish_divergence", title = "Bearish signal", display = "none", overlay = false, layer = false)
plot(regular_bullish, id = "regular_bullish", title = "Regular bullish signal", display = "none", overlay = false, layer = false)
plot(hidden_bullish, id = "hidden_bullish", title = "Hidden bullish signal", display = "none", overlay = false, layer = false)
plot(regular_bearish, id = "regular_bearish", title = "Regular bearish signal", display = "none", overlay = false, layer = false)
plot(hidden_bearish, id = "hidden_bearish", title = "Hidden bearish signal", display = "none", overlay = false, layer = false)

segment(
    start_value = previous_low_rsi,
    end_value = pivot_low_rsi,
    start_index = previous_low_bar,
    end_index = pivot_bar,
    id = "regular_bullish",
    title = "Regular bullish",
    color_slot = "bullish",
    width = 1.4,
    visible = show_regular_bullish && regular_bullish,
    text = "Bull"
)
segment(
    start_value = previous_low_rsi,
    end_value = pivot_low_rsi,
    start_index = previous_low_bar,
    end_index = pivot_bar,
    id = "hidden_bullish",
    title = "Hidden bullish",
    color_slot = "bullish",
    width = 1.4,
    visible = show_hidden_bullish && hidden_bullish,
    text = "H Bull"
)
segment(
    start_value = previous_high_rsi,
    end_value = pivot_high_rsi,
    start_index = previous_high_bar,
    end_index = pivot_bar,
    id = "regular_bearish",
    title = "Regular bearish",
    color_slot = "bearish",
    width = 1.4,
    visible = show_regular_bearish && regular_bearish,
    text = "Bear"
)
segment(
    start_value = previous_high_rsi,
    end_value = pivot_high_rsi,
    start_index = previous_high_bar,
    end_index = pivot_bar,
    id = "hidden_bearish",
    title = "Hidden bearish",
    color_slot = "bearish",
    width = 1.4,
    visible = show_hidden_bearish && hidden_bearish,
    text = "H Bear"
)

previous_low_rsi := select(pivot_low, pivot_low_rsi, previous_low_rsi)
previous_low_price := select(pivot_low, pivot_low_price, previous_low_price)
previous_low_bar := select(pivot_low, pivot_bar, previous_low_bar)
has_previous_low := has_previous_low || pivot_low
previous_high_rsi := select(pivot_high, pivot_high_rsi, previous_high_rsi)
previous_high_price := select(pivot_high, pivot_high_price, previous_high_price)
previous_high_bar := select(pivot_high, pivot_bar, previous_high_bar)
has_previous_high := has_previous_high || pivot_high

style("rsi", title = "RSI")
style("middle", title = "Middle line", role = "secondary")
style("upper", title = "Overbought", role = "success")
style("lower", title = "Oversold", role = "danger")
style("bullish", title = "Bullish divergence", role = "success", shade = "strong")
style("bearish", title = "Bearish divergence", role = "danger", shade = "strong")
style("neutral_pivot", title = "Pivot context", role = "secondary", shade = "faint")
style("fill", title = "Background fill", role = "primary", shade = "faint")
fill(upper = "upper_band", lower = "lower_band", color_slot = "fill", opacity = 0.12)
