language(1)
indicator("CVD", id = "flowsurface.cumulative-volume-delta", layer_name = "Cumulative Volume Delta", value_precision = "base_ticker_min_qty", axis_label_mode = "abbreviated", header_label_mode = "commas")
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, na)
value = ta.cum(delta)
plot(value, id = "value", title = "CVD", precision = "instrument", color_slot = "main", layer_title = "Cumulative Volume Delta", overlay = false)

style("main", title = "Line")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
mark(title = "Bars", source = "value", kind = "regular_bar", color_slot = "main")
